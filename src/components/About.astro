---
import ResponsiveImage from "./ResponsiveImage.astro";
import type { home } from "../data/home";
import WidthContainer from "./WidthContainer.astro";
import DownloadCvButton from "./DownloadCvButton.astro";

type Props = (typeof home)["about"] & { cvUrl: string };

const { image, title, subtitle, description, cvUrl } = Astro.props;
---

<WidthContainer>
  <section id="about" class="about-section">
    <ResponsiveImage
      class="image"
      src={image}
      widths={[400, 500, 640, 800, 1000]}
      sizes="(max-width: 48rem) calc(100vw - 32px), 500px"
      alt=""
    />

    <div class="content-wrapper">
      <div class="title-wrapper">
        <h2 class="title">{title}</h2>
        <p class="subtitle">{subtitle}</p>
      </div>
      {description.map((paragraph) => (
        <p class="description">{paragraph}</p>
      ))}
      <div class="cta-button-wrapper">
        <DownloadCvButton cvUrl={cvUrl} location="about" />
      </div>
    </div>
  </section>
</WidthContainer>

<style>
  .about-section {
    margin-top: calc(var(--spacing-64) * -1);
    display: flex;
    align-items: center;
    gap: var(--spacing-128);
  }

  .image {
    width: 100%;
    max-width: 500px;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .title-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }
  .subtitle {
    font-size: var(--font-size-16-20);
    font-weight: 600;
  }
  .description {
    font-size: var(--font-size-16-20);
    font-weight: 400;
  }

  .cta-button-wrapper {
    margin-top: var(--spacing-16);
  }

  @media (max-width: 48rem) {
    .about-section {
      margin-top: unset;
      flex-direction: column-reverse;
      gap: var(--spacing-32);
    }

    .image {
      max-width: 100%;
    }

    .cta-button-wrapper {
      margin-bottom: var(--spacing-16);
    }
  }
</style>

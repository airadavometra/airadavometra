---
import { Icon } from "astro-icon/components";

interface Props {
  cvUrl: string;
  /** Where the button sits, sent with the cv_download analytics event */
  location: "header" | "about";
}

const { cvUrl, location } = Astro.props;
---

<a
  href={cvUrl}
  download="Daria-Artemova-CV.pdf"
  class="download-cv"
  data-track="cv_download"
  data-track-location={location}
>
  <Icon name="ph:download-simple" class="icon" aria-hidden="true" />
  <slot>Download CV</slot>
</a>

<style>
  .download-cv {
    width: fit-content;
    position: relative;
    z-index: 1;
    padding: var(--spacing-6) var(--spacing-16);
    padding-right: var(--spacing-24);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-16);
    border: var(--border-width) solid var(--black);
    font-size: var(--font-size-16-20);
    font-weight: 600;
    transition: color var(--transition-slow);
    overflow: hidden;
  }

  .download-cv::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--black);
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition-slow);
  }

  .download-cv:hover {
    color: var(--white);
  }

  .download-cv:hover::before {
    transform: scaleX(1);
  }

  .icon {
    width: var(--font-size-24-32);
    height: var(--font-size-24-32);
  }

  @media (max-width: 48rem) {
    .download-cv {
      padding: var(--spacing-6) var(--spacing-12);
      padding-right: var(--spacing-16);
    }
  }
</style>

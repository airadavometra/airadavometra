---
import { Icon } from "astro-icon/components";
import { render, type CollectionEntry } from "astro:content";
import ResponsiveImage from "./ResponsiveImage.astro";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

// The description is each file's Markdown body
const items = await Promise.all(
  Astro.props.projects.map(async (entry) => ({
    ...entry.data,
    Description: (await render(entry)).Content,
  })),
);
---

<WidthContainer>
  <section id="projects" class="projects-section">
    <h2 class="title">Pet projects</h2>

    <ul class="projects-list">
      {items.map((project) => {
        const { screenshots, Description } = project;

        return (
          <li class="project-item">
            <div class="gallery js-gallery">
              {/* One cover per screenshot; the script shows the selected one */}
              {screenshots.map((screenshot, index) => (
                <ResponsiveImage
                  src={screenshot}
                  widths={[400, 700, 1000, 1400]}
                  sizes="(max-width: 48rem) calc(100vw - 32px), min(688px, calc(50vw - 48px))"
                  alt={`${project.title} screenshot`}
                  class="project-image js-gallery-cover"
                  hidden={index > 0}
                />
              ))}

              {screenshots.length > 1 && (
                <ul class="thumbnails">
                  {screenshots.map((screenshot, index) => (
                    <li>
                      <button
                        class="thumbnail js-gallery-thumb"
                        aria-pressed={index === 0 ? "true" : "false"}
                        aria-label={`Show screenshot ${index + 1} of ${screenshots.length}, ${project.title}`}
                      >
                        <ResponsiveImage
                          src={screenshot}
                          widths={[150, 300]}
                          sizes="(max-width: 48rem) calc((100vw - 56px) / 5), min(131px, calc((50vw - 80px) / 5))"
                          alt=""
                          class="thumbnail-image"
                        />
                      </button>
                    </li>
                  ))}
                </ul>
              )}
            </div>

            <div class="project-header">
              <h3 class="project-title">
                {project.link ? (
                  <a
                    href={project.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="project-link hover-underline"
                    aria-label={`Open ${project.title}`}
                    data-track="project_click"
                    data-track-project={project.title}
                  >
                    <span>{project.title}</span>
                    <Icon
                      name="ph:arrow-up-right"
                      class="icon"
                      aria-hidden="true"
                    />
                  </a>
                ) : (
                  project.title
                )}
              </h3>
              <span class="project-year">{project.year}</span>
            </div>

            <div class="project-description">
              <Description />
            </div>

            {project.tags.length > 0 && (
              <ul class="project-tags">
                {project.tags.map((tag) => (
                  <li class="project-tag">{tag}</li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</WidthContainer>

<style>
  .projects-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-48);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-64);
  }

  .project-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  /* Every cover has the same shape, whatever the uploaded screenshot's size */
  .project-image {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border: var(--border-width) solid var(--grey);
  }
  /* The reset makes images display: block, which would override [hidden] */
  .project-image[hidden] {
    display: none;
  }

  .thumbnails {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--spacing-8);
  }
  .thumbnail {
    display: block;
    width: 100%;
    border: var(--border-width) solid var(--grey);
    opacity: 0.55;
    transition: opacity var(--transition-fast);
  }
  .thumbnail-image {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
  }
  .thumbnail[aria-pressed="true"] {
    border-color: var(--blue);
    opacity: 1;
  }
  /* Flush with the border, so together they make one 2px frame. Keyboard
     focus shows the browser's own ring instead. */
  .thumbnail[aria-pressed="true"]:not(:focus-visible) {
    outline: var(--border-width) solid var(--blue);
  }
  .thumbnail:focus-visible {
    opacity: 1;
  }
  @media (hover: hover) {
    .thumbnail:hover {
      opacity: 1;
    }
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  .project-title {
    font-size: var(--font-size-16-24);
    font-weight: 600;
  }
  .project-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
  }
  .icon {
    width: var(--font-size-24-32);
    height: var(--font-size-24-32);
  }
  .project-year {
    font-size: var(--font-size-16-24);
    font-weight: 600;
    color: var(--grey);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16) var(--spacing-24);
  }
  .project-tag {
    padding: var(--spacing-4) var(--spacing-16);
    border: var(--border-width) solid var(--black);
  }

  @media (max-width: 48rem) {
    .projects-list {
      display: flex;
      flex-direction: column;
    }
    .project-tags {
      gap: var(--spacing-16);
    }
    .thumbnails {
      gap: var(--spacing-6);
    }
  }
</style>

<script>
  // Clicking a thumbnail shows that screenshot as the cover. The new cover only
  // replaces the old one once it has loaded, so the frame never flashes empty.
  document.querySelectorAll(".js-gallery").forEach((gallery) => {
    const covers =
      gallery.querySelectorAll<HTMLImageElement>(".js-gallery-cover");
    const thumbs = gallery.querySelectorAll(".js-gallery-thumb");
    let wanted: HTMLImageElement | undefined;

    thumbs.forEach((thumb, index) => {
      thumb.addEventListener("click", () => {
        thumbs.forEach((other) =>
          other.setAttribute("aria-pressed", String(other === thumb)),
        );

        const next = covers[index];
        wanted = next;
        const show = () => {
          if (wanted !== next) return; // A later click won
          covers.forEach((cover) => (cover.hidden = cover !== next));
        };

        if (next.complete && next.naturalWidth > 0) {
          show();
        } else {
          next.addEventListener("load", show, { once: true });
          next.addEventListener("error", show, { once: true });
          next.loading = "eager";
        }
      });
    });
  });
</script>

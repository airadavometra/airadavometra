---
import { Icon } from "astro-icon/components";
import ResponsiveImage from "./ResponsiveImage.astro";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  title: string;
  email: string;
  linkedinLink: string;
  image: ImageMetadata;
}

const { title, email, linkedinLink, image } = Astro.props;
---

<WidthContainer>
  <section id="contact" class="contact-section">
    <div class="info-wrapper">
      <h2 class="title">{title}</h2>
      <div class="links-wrapper">
        <button
          class="contact-link hover-underline js-copy-email"
          data-email={email}
          aria-label="Copy email"
          data-track="email_copy"
        >
          <span class="email-container">
            <span class="email-text js-email-text">{email}</span>
            <span class="copied-text js-copied-text">Email was copied!</span>
          </span>
          <Icon name="ph:copy" class="icon" aria-hidden="true" />
        </button>

        <a
          href={linkedinLink}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link hover-underline"
          data-track="linkedin_click"
          data-track-location="contact"
        >
          <span>LinkedIn</span>
          <Icon name="ph:arrow-up-right" class="icon" aria-hidden="true" />
        </a>
      </div>
    </div>

    <div class="contact-image-wrapper">
      <WidthContainer>
        <ResponsiveImage
          src={image}
          widths={[400, 800, 1200]}
          sizes="(max-width: 48rem) 100vw, 800px"
          alt=""
          class="contact-image"
        />
      </WidthContainer>
    </div>
  </section>
</WidthContainer>

<style>
  .contact-section {
    min-height: 400px;
    display: flex;
    justify-content: space-between;
  }

  .contact-image-wrapper {
    width: 100%;
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: -1;
  }

  /* The art sits behind the text, so on narrower screens it shrinks with the
     space beside the text column (about 23rem). It's 10% bigger than that
     space: its top-left corner is empty (the drawing is round), so the box can
     reach into the text column without the drawing touching the text. */
  .contact-image {
    max-width: min(800px, calc((100% - 23rem) * 1.1));
    margin-left: auto;
  }

  .info-wrapper {
    margin-top: var(--spacing-128);
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .links-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
    font-size: var(--font-size-20-24);
    font-weight: 600;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font-family: inherit;
    color: inherit;
    position: relative;
  }

  .email-container {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .email-text {
    transition:
      opacity var(--transition-bounce),
      transform var(--transition-bounce);
  }

  .copied-text {
    position: absolute;
    left: 0;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity var(--transition-bounce),
      transform var(--transition-bounce);
    color: var(--black);
    font-weight: 400;
    pointer-events: none;
    white-space: nowrap;
  }

  .is-copied .email-text {
    opacity: 0;
    transform: translateY(-10px);
  }

  .is-copied .copied-text {
    opacity: 1;
    transform: translateY(0);
  }

  .icon {
    width: var(--font-size-24-32);
    height: var(--font-size-24-32);
  }

  @media (max-width: 48rem) {
    .contact-section {
      margin-top: var(--spacing-64);
      flex-direction: column;
      gap: var(--spacing-32);
    }

    /* It's pinned to the page bottom, so a wider screen would push it up
       behind the links: stop growing at about large-phone size */
    .contact-image {
      margin-right: calc(var(--spacing-16) * -1);
      max-width: min(100%, 30rem);
    }

    .info-wrapper {
      margin: 0;
    }

    .links-wrapper {
      gap: var(--spacing-16);
    }
  }
</style>

<script>
  const copyButtons = document.querySelectorAll<HTMLElement>(".js-copy-email");

  copyButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const email = button.dataset.email;
      if (!email) return;

      try {
        await navigator.clipboard.writeText(email);

        // Swap the address for the "copied" message, then swap back
        button.classList.add("is-copied");
        setTimeout(() => {
          button.classList.remove("is-copied");
        }, 2500);
      } catch (err) {
        console.error("Failed to copy email: ", err);
      }
    });
  });
</script>

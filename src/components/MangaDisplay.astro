---
import type { CollectionEntry } from "astro:content";
import ResponsiveImage from "./ResponsiveImage.astro";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  manga: CollectionEntry<"manga">["data"];
}

const { manga } = Astro.props;
---

<div class="manga-wrapper">
  <WidthContainer>
    <section class="manga-section">
      <h2 class="title visually-hidden">Manga panel: {manga.title}</h2>

      <div class="images-container">
        {manga.panels.map((panel) => (
          <ResponsiveImage
            src={panel.src}
            widths={[360, 540, 720, 1080]}
            sizes="(max-width: 48rem) calc(100vw - 32px), min(360px, calc((100vw - 32px) / 4))"
            alt={panel.alt}
            class="manga-panel"
          />
        ))}
      </div>
    </section>
  </WidthContainer>
</div>

<style>
  .manga-wrapper {
    width: 100%;
    margin-top: var(--spacing-32);
    margin-bottom: var(--spacing-32);
    background-color: var(--grey-transparent);
    padding: var(--spacing-48) 0;
  }

  .manga-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }

  .images-container {
    width: 100%;
    display: flex;
    overflow-x: auto;
  }

  .manga-panel {
    width: 100%;
    min-width: 200px;
    overflow: hidden;
  }

  @media (max-width: 48rem) {
    .images-container {
      flex-direction: column;
    }
  }
</style>

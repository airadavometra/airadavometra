---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import ExperienceSkills from "../components/ExperienceSkills.astro";
import Projects from "../components/Projects.astro";
import MangaDisplay from "../components/MangaDisplay.astro";
import Contact from "../components/Contact.astro";
import { getCollection, getEntry, render } from "astro:content";
import cvUrl from "../assets/daria-artemova-cv.pdf?url";

// All content comes from the Markdown files in src/content/
const homeEntry = await getEntry("home", "home");
if (!homeEntry) throw new Error("src/content/home.md is missing");
const home = homeEntry.data;
const { Content: AboutText } = await render(homeEntry);

const byOrder = (
  a: { data: { order: number } },
  b: { data: { order: number } },
) => a.data.order - b.data.order;
const experience = (await getCollection("experience")).sort(byOrder);
const projects = (await getCollection("projects")).sort(byOrder);
const manga = await getCollection("manga");
const mangaAt = (placement: (typeof manga)[number]["data"]["placement"]) =>
  manga.filter((strip) => strip.data.placement === placement);

// Structured data for search engines: who the page is about, and which
// profiles are the same person. The title reads "Name — Role".
const [name, jobTitle] = home.title.split(" — ");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  ...(jobTitle && { jobTitle }),
  url: Astro.site?.href,
  sameAs: [home.githubLink, home.linkedinLink],
};
// Escape "<" so no text can ever close the script tag early
const personJson = JSON.stringify(person).replace(/</g, "\\u003c");
---

<Layout title={home.title} description={home.description}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={personJson}
  />
  <Header
    githubLink={home.githubLink}
    linkedinLink={home.linkedinLink}
    cvUrl={cvUrl}
  />

  <main class="main">
    <Hero title={home.title} image={home.heroImage} />

    <About {...home.about} cvUrl={cvUrl}>
      <AboutText />
    </About>

    {mangaAt("after-about").map((strip) => (
      <MangaDisplay manga={strip.data} />
    ))}

    <ExperienceSkills
      experience={experience}
      experienceYears={home.experienceYears}
      skills={home.skills}
    />

    {mangaAt("after-experience").map((strip) => (
      <MangaDisplay manga={strip.data} />
    ))}

    <Projects projects={projects} />

    {mangaAt("after-projects").map((strip) => (
      <MangaDisplay manga={strip.data} />
    ))}

    <Contact
      title={home.contact.title}
      email={home.email}
      linkedinLink={home.linkedinLink}
      image={home.contact.image}
    />
  </main>
  <Footer />
</Layout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-128);
  }

  @media (max-width: 48rem) {
    .main {
      gap: var(--spacing-64);
    }
  }
</style>

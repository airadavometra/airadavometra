---
import "@fontsource-variable/open-sans/wght.css";
import "@fontsource-variable/open-sans/wght-italic.css";
import openSansLatin from "@fontsource-variable/open-sans/files/open-sans-latin-wght-normal.woff2?url";
import "../styles/reset.css";
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import favicon from "../assets/favicon.png";
import shareImage from "../assets/share.png";

interface Props {
  title: string;
  /** The search result snippet and link-preview text */
  description: string;
}

const { title, description: metaDescription } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const faviconUrl = favicon.src;
// Link previews need an absolute URL. The image is 1200×630.
const shareImageUrl = new URL(shareImage.src, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Self-hosted Open Sans; preload the Latin subset every page needs -->
    <link
      rel="preload"
      href={openSansLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon -->
    <link rel="icon" href={faviconUrl} />

    <!-- Open Graph (link previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- X uses the Open Graph tags above, but needs this for the big image -->
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <Analytics />
    <script>
      import { initClickTracking } from "../lib/analytics";
      initClickTracking();
    </script>
  </body>
</html>

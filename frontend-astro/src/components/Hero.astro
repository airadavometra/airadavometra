---
import { urlFor } from "../lib/sanity";
import type { Home } from "../lib/queries";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  title: Home["title"] | undefined;
  image: Home["heroImage"] | undefined;
}

const { title, image } = Astro.props;
---

<section class="hero-section">
  <h1 class="visually-hidden">{title}</h1>

  {image && (
    <WidthContainer>
      <img src={urlFor(image).url()} alt="" role="presentation" />
    </WidthContainer>
  )}

  <div class="blue-rectangle"></div>
</section>

<style>
  .hero-section {
    padding: var(--spacing-128) 0;
    position: relative;
  }

  .blue-rectangle {
    width: 45.5%;
    margin-left: auto;
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--blue);
  }

  @media (max-width: 48rem) {
    .blue-rectangle {
      width: 77.5%;
    }
  }
</style>

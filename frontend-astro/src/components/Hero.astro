---
import ResponsiveImage from "./ResponsiveImage.astro";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  title: string;
  image: ImageMetadata;
}

const { title, image } = Astro.props;
---

<section class="hero-section">
  <h1 class="visually-hidden">{title}</h1>

  <WidthContainer>
    {/* The LCP element: priority loads it eagerly with fetchpriority="high" */}
    <ResponsiveImage
      src={image}
      widths={[400, 600, 700, 800]}
      sizes="(max-width: 1172px) calc(100vw - 32px), 1140px"
      alt=""
      priority
    />
  </WidthContainer>

  <div class="blue-rectangle"></div>
</section>

<style>
  .hero-section {
    padding: var(--spacing-128) 0;
    position: relative;
  }

  .blue-rectangle {
    width: 45.5%;
    margin-left: auto;
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--blue);
  }

  @media (max-width: 48rem) {
    .blue-rectangle {
      width: 77.5%;
    }
  }
</style>

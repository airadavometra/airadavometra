---
import { sanityImage } from "../lib/image";
import type { Home } from "../lib/queries";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  title: Home["title"] | undefined;
  image: Home["heroImage"] | undefined;
}

const { title, image } = Astro.props;
---

<section class="hero-section">
  <h1 class="visually-hidden">{title}</h1>

  {image && (
    <WidthContainer>
      <img
        {...sanityImage(image, {
          widths: [400, 600, 700, 800],
          sizes: "(max-width: 1172px) calc(100vw - 32px), 1140px",
        })}
        alt=""
        fetchpriority="high"
      />
    </WidthContainer>
  )}

  <div class="blue-rectangle"></div>
</section>

<style>
  .hero-section {
    padding: var(--spacing-128) 0;
    position: relative;
  }

  .blue-rectangle {
    width: 45.5%;
    margin-left: auto;
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--blue);
  }

  @media (max-width: 48rem) {
    .blue-rectangle {
      width: 77.5%;
    }
  }
</style>

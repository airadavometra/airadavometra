---
import { urlFor } from "../lib/sanity";
import type { Home } from "../lib/queries";
import WidthContainer from "./WidthContainer.astro";
import ExternalLinkIcon from "./icons/ExternalLink.astro";
import Github from "./icons/Github.astro";

interface Props {
  projects: Home["projects"] | undefined;
  githubLink: Home["githubLink"] | undefined;
}

const { projects, githubLink } = Astro.props;
---

<WidthContainer>
  <section id="projects" class="projects-section">
    <h2 class="title">Pet projects</h2>

    <ul class="projects-list">
      {projects?.map((project) => (
        <li class="project-item">
          <div class="project-image-container">
            {project.image && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Open ${project.title}`}
                data-track="project_click"
                data-track-project={project.title}
              >
                <img
                  src={urlFor(project.image).url()}
                  alt={`${project.title} screenshot`}
                  class="project-image"
                />
              </a>
            )}
          </div>

          <div class="project-header">
            {project.link && (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class="project-link hover-underline"
                aria-label={`Open ${project.title}`}
                data-track="project_click"
                data-track-project={project.title}
              >
                <span>{project.title}</span>
                <ExternalLinkIcon class="icon" />
              </a>
            )}
            <span class="project-year">{project.year}</span>
          </div>

          <p class="project-description">{project.description}</p>

          {project.tags && project.tags.length > 0 && (
            <ul class="project-tags">
              {project.tags.map((tag) => (
                <li class="project-tag">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>

    {githubLink && (
      <div class="github-link-wrapper">
        <a
          href={githubLink}
          target="_blank"
          rel="noopener noreferrer"
          class="github-link hover-underline"
          data-track="github_click"
          data-track-location="projects"
        >
          <span>Check out my GitHub</span>
          <Github class="github-icon" />
        </a>
      </div>
    )}
  </section>
</WidthContainer>

<style>
  .projects-section {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-48);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }

  .projects-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-64);
  }

  .project-item {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-16);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
  }
  .project-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-12);
    font-size: var(--font-size-16-24);
    font-weight: 600;
  }
  .icon {
    width: var(--font-size-24-32);
    height: var(--font-size-24-32);
  }
  .project-year {
    font-size: var(--font-size-16-24);
    font-weight: 600;
    color: var(--grey);
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-16) var(--spacing-24);
  }
  .project-tag {
    padding: var(--spacing-4) var(--spacing-16);
    border: var(--border-width) solid var(--black);
  }

  .github-link-wrapper {
    margin-top: var(--spacing-128);
    display: flex;
    justify-content: center;
  }
  .github-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-16);
    font-size: var(--font-size-20-32);
    font-weight: 600;
    text-align: center;
  }
  .github-icon {
    width: var(--font-size-32-48);
    height: var(--font-size-32-48);
  }

  @media (max-width: 48rem) {
    .projects-list {
      display: flex;
      flex-direction: column;
    }
    .project-tags {
      gap: var(--spacing-16);
    }

    .github-link-wrapper {
      margin-top: var(--spacing-64);
    }
    .github-link {
      flex-direction: column-reverse;
      gap: var(--spacing-12);
    }
  }
</style>

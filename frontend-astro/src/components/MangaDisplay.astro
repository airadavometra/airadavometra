---
import { urlFor } from "../lib/sanity";
import type { Manga } from "../lib/queries";
import WidthContainer from "./WidthContainer.astro";

interface Props {
  manga: Manga | null | undefined;
}

const { manga } = Astro.props;

// An empty slot in the CMS renders nothing
if (!manga?.title || !manga.images?.length) {
  return null;
}
---

<div class="manga-wrapper">
  <WidthContainer>
    <section class="manga-section">
      <h2 class="title visually-hidden">Manga panel: {manga.title}</h2>

      <div class="images-container">
        {manga.images.map((image) => (
          <img
            src={urlFor(image).url()}
            alt={image.alt || manga.title}
            class="manga-panel"
          />
        ))}
      </div>
    </section>
  </WidthContainer>
</div>

<style>
  .manga-wrapper {
    width: 100%;
    margin-top: var(--spacing-64);
    margin-bottom: var(--spacing-64);
    background-color: var(--grey-transparent);
    padding: var(--spacing-48) 0;
  }

  .manga-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }

  .images-container {
    width: 100%;
    display: flex;
    overflow-x: auto;
  }

  .manga-panel {
    width: 100%;
    min-width: 200px;
    overflow: hidden;
  }

  @media (max-width: 48rem) {
    .images-container {
      flex-direction: column;
    }
  }
</style>

---
import { urlFor } from "../lib/sanity";
import type { Home } from "../lib/queries";
import WidthContainer from "./WidthContainer.astro";
import DownloadCvButton from "./DownloadCvButton.astro";

interface Props {
  image: Home["aboutMeImage"] | undefined;
  title: Home["aboutMeTitle"] | undefined;
  subtitle: Home["aboutMeSubtitle"] | undefined;
  description: Home["aboutMeDescription"] | undefined;
  cvUrl: Home["cvUrl"] | undefined;
}

const { image, title, subtitle, description, cvUrl } = Astro.props;
---

<WidthContainer>
  <section id="about" class="about-section">
    {image && <img class="image" src={urlFor(image).url()} alt="" />}

    <div class="content-wrapper">
      <div class="title-wrapper">
        {title && <h2 class="title">{title}</h2>}
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </div>
      {description
        ?.split("\n")
        .map(
          (paragraph) => paragraph && <p class="description">{paragraph}</p>,
        )}
      <div class="cta-button-wrapper">
        <DownloadCvButton cvUrl={cvUrl} location="about" />
      </div>
    </div>
  </section>
</WidthContainer>

<style>
  .about-section {
    margin-top: calc(var(--spacing-64) * -1);
    display: flex;
    align-items: center;
    gap: var(--spacing-128);
  }

  .image {
    width: 100%;
    max-width: 500px;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-32);
  }

  .title-wrapper {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-8);
  }

  .title {
    font-size: var(--font-size-32-40);
    font-weight: 700;
  }
  .subtitle {
    font-size: var(--font-size-16-20);
    font-weight: 600;
  }
  .description {
    font-size: var(--font-size-16-20);
    font-weight: 400;
  }

  .cta-button-wrapper {
    margin-top: var(--spacing-16);
  }

  @media (max-width: 48rem) {
    .about-section {
      margin-top: unset;
      flex-direction: column-reverse;
      gap: var(--spacing-32);
    }

    .image {
      max-width: 100%;
    }

    .cta-button-wrapper {
      margin-bottom: var(--spacing-16);
    }
  }
</style>

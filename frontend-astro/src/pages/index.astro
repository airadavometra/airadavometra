---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import ExperienceSkills from "../components/ExperienceSkills.astro";
import Projects from "../components/Projects.astro";
import MangaDisplay from "../components/MangaDisplay.astro";
import Contact from "../components/Contact.astro";
import { home } from "../data/home";
import { skills } from "../data/skills";
import { projects } from "../data/projects";
import { coldTea, stupidCode } from "../data/manga";

// Structured data for search engines: who the page is about, and which
// profiles are the same person. The title reads "Name — Role".
const [name, jobTitle] = home.title.split(" — ");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name,
  ...(jobTitle && { jobTitle }),
  url: Astro.site?.href,
  sameAs: [home.githubLink, home.linkedinLink],
};
// Escape "<" so no text can ever close the script tag early
const personJson = JSON.stringify(person).replace(/</g, "\\u003c");
---

<Layout>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={personJson}
  />
  <Header
    githubLink={home.githubLink}
    linkedinLink={home.linkedinLink}
    cvUrl={home.cvUrl}
  />

  <main class="main">
    <Hero title={home.title} image={home.heroImage} />

    <About {...home.about} cvUrl={home.cvUrl} />

    {/* Manga strips sit between sections: after About, after Experience &
    skills, and (when there's a third) after Pet projects */}
    <MangaDisplay manga={coldTea} />

    <ExperienceSkills
      experience={home.experience}
      experienceYears={home.experienceYears}
      skills={skills}
    />

    <MangaDisplay manga={stupidCode} />

    <Projects projects={projects} />

    <Contact
      title={home.contact.title}
      email={home.email}
      linkedinLink={home.linkedinLink}
      image={home.contact.image}
    />
  </main>
  <Footer />
</Layout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-128);
  }

  @media (max-width: 48rem) {
    .main {
      gap: var(--spacing-64);
    }
  }
</style>

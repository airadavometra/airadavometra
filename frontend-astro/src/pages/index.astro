---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import ExperienceSkills from "../components/ExperienceSkills.astro";
import Projects from "../components/Projects.astro";
import MangaDisplay from "../components/MangaDisplay.astro";
import Contact from "../components/Contact.astro";
import { client } from "../lib/sanity";
import { pageQuery } from "../lib/queries";

const { settings, home } = await client.fetch(pageQuery);

// Structured data for search engines: who the page is about, and which
// profiles are the same person. The title reads "Name — Role".
const [name, jobTitle] = (home?.title ?? "").split(" — ");
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: name || "Daria Artemova",
  ...(jobTitle && { jobTitle }),
  url: Astro.site?.href,
  sameAs: [home?.githubLink, home?.linkedinLink].filter(Boolean),
};
// Escape "<" so CMS text can never close the script tag early
const personJson = JSON.stringify(person).replace(/</g, "\\u003c");
---

<Layout settings={settings}>
  <script
    is:inline
    type="application/ld+json"
    slot="head"
    set:html={personJson}
  />
  <Header
    githubLink={home?.githubLink}
    linkedinLink={home?.linkedinLink}
    cvUrl={home?.cvUrl}
  />

  <main class="main">
    <Hero title={home?.title} image={home?.heroImage} />

    <About
      image={home?.aboutMeImage}
      title={home?.aboutMeTitle}
      subtitle={home?.aboutMeSubtitle}
      description={home?.aboutMeDescription}
      cvUrl={home?.cvUrl}
    />

    <MangaDisplay manga={home?.featuredManga1} />

    <ExperienceSkills
      experience={home?.experience}
      experienceYears={home?.experienceYears}
      skills={home?.skills}
    />

    <MangaDisplay manga={home?.featuredManga2} />

    <Projects projects={home?.projects} />

    <MangaDisplay manga={home?.featuredManga3} />

    <Contact
      title={home?.contactSectionTitle}
      email={home?.email}
      linkedinLink={home?.linkedinLink}
      image={home?.contactSectionImage}
    />
  </main>
  <Footer />
</Layout>

<style>
  .main {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-128);
  }

  @media (max-width: 48rem) {
    .main {
      gap: var(--spacing-64);
    }
  }
</style>

{
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run dev)",
      "Bash(npm run preview)",
      "Bash(npm run preview *)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run screenshot *)",
      "Bash(npm run a11y *)",
      "Bash(npm run typegen)",
      "Bash(node scripts/screenshot.mjs *)",
      "Bash(node scripts/a11y.mjs *)",
      "Bash(node scripts/diff.mjs *)",
      "Bash(npx astro check)",
      "Bash(npx astro build)",
      "Bash(npx astro preview *)",
      "Bash(npx sanity typegen *)",
      "Bash(npx sanity schema *)",
      "Bash(npx lighthouse *)",
      "Bash(npx -y lighthouse@12 *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": ["Bash(git commit *)", "Bash(git push *)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Formatting with Prettier"
          }
        ]
      }
    ]
  }
}
